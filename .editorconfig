root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_size = 4

# IDE0305: Collection initialization can be simplified (ToList → [..])
# Suppressed: ToList() is explicit and readable; collection expression syntax is a style preference.
dotnet_diagnostic.IDE0305.severity = none

[*.{csproj,slnx,props,targets}]
indent_size = 2
